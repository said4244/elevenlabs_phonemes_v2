LIVEKIT_API_KEY=-
LIVEKIT_API_SECRET=-
LIVEKIT_URL=-

OPENAI_API_KEY=-

ELEVEN_API_KEY=-
ELEVEN_VOICE_ID="jAAHNNqlbAX9iWjJPEtE"
ELEVEN_MODEL="eleven_multilingual_v2"

# --- Firestore-driven system prompt ---
# Copy this file to .env (same folder) and fill in values.
# This repo's .gitignore ignores .env so secrets won't be committed.

# Which Firestore character doc to load: characters/{CHARACTER_ID}
CHARACTER_ID=1

# Firestore credentials (pick ONE):
# Option A:
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\serviceAccount.json
# Option B:
FIREBASE_SERVICE_ACCOUNT_JSON=C:\\path\\to\\serviceAccount.json

# Optional: override Firestore collection name (default: characters)
# FIRESTORE_CHARACTERS_COLLECTION=characters

# Prompt fetch behavior:
# If enabled, the agent will NOT start unless Firestore prompt loads successfully.
SYSTEM_PROMPT_REQUIRED=0

# If SYSTEM_PROMPT_REQUIRED=0, this timeout controls how long to wait before falling back.
SYSTEM_PROMPT_FETCH_TIMEOUT_SECONDS=2.0

# Cache TTL (seconds)
SYSTEM_PROMPT_CACHE_TTL_SECONDS=3600